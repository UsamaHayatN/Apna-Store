
# =============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================

# Server-Side Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mens_fashion_db"

# Authentication Secret (Used by Jose to sign/verify JWT session cookies)
# Generate a strong 32+ character random secret (e.g. `openssl rand -base64 32`)
AUTH_SECRET="change-me-to-a-secure-random-32-character-secret-key-12345"

# Development Admin Seed Password (Server-Side ONLY)
# Used exclusively in local/development environments by `npm run db:seed`
# to provision the local development OWNER account (usamanissoana555@gmail.com).
# NEVER prefix with NEXT_PUBLIC_. NEVER commit actual values to Git.
INITIAL_ADMIN_PASSWORD=

# Application Public Host URL (Accessible by browser and server)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Future Payment Provider (Server-Side Secret Keys)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Future Cloud / Object Storage (Media Uploads)
# S3_BUCKET_NAME=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Future Transactional Email Provider
# RESEND_API_KEY="re_..."
# SYSTEM_FROM_EMAIL="orders@yourbrand.com"
